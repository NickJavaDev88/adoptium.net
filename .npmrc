# Supply-chain hardening. Rationale: docs/supply-chain-hardening.md
#
# Refuse to resolve any package version published less than 1 day ago, giving
# the ecosystem time to detect and unpublish compromised releases. Recent
# npm compromises were caught well inside this window (debug/chalk ~2.5h,
# Shai-Hulud ~12h), so a 1-day quarantine blocks them without slowing down
# the daily Dependabot cadence.
min-release-age=1

# min-release-age is silently ignored by npm < 11.10.0. Combined with the
# "engines" field in package.json, this turns a silent no-op into a hard
# failure, so the quarantine above can never be decorative.
engine-strict=true
